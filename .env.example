# Veylor Overseer Configuration
OVERSEER_ENV=development
OVERSEER_BASE_URL=http://localhost:8080
OVERSEER_SECRET_KEY=dev_insecure_secret_key_minimum_32_characters_long

# MongoDB
OVERSEER_MONGODB_URL=mongodb://localhost:27017
OVERSEER_MONGODB_DATABASE=veylor_overseer

# Veylor SSO Integration
OVERSEER_SSO_ISSUER=http://localhost:8000
OVERSEER_SSO_CLIENT_ID=overseer
OVERSEER_SSO_REDIRECT_URI=http://localhost:8080/auth/callback
